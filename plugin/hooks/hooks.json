{
  "description": "Forward every session event to `cc-ran hook`, which must be on PATH. It always exits 0 and prints nothing.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "cc-ran hook", "timeout": 5 }] }]
  }
}
