{
  "name": "session-start-resets-attention",
  "description": "compact 以外の SessionStart は承認待ちも idle に戻す",
  "start": {
    "attention": "working",
    "since": 5
  },
  "steps": [
    {
      "at": 10,
      "input": "PermissionRequest.subagent",
      "expect": {
        "attention": "needs_permission",
        "since": 10,
        "agent_id": "agent-1"
      }
    },
    {
      "at": 20,
      "input": "SessionStart.clear",
      "expect": {
        "attention": "idle",
        "since": 20,
        "agent_id": null
      }
    }
  ]
}
